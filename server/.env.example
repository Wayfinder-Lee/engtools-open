# server 环境变量示例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 生产环境请在运行平台的环境变量配置里设置，不要用 .env

# --- LLM 上游（任一 OpenAI 兼容接口）---
LLM_ENDPOINT=https://你的中转站或官方endpoint/v1/chat/completions
LLM_API_KEY=sk-你的密钥

# --- 会话 ---
JWT_SECRET=用 openssl rand -base64 32 生成的随机串
JWT_EXPIRES_IN=30d

# --- CORS 白名单（逗号分隔，末尾不要斜杠）---
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://你的域名

# --- Tablestore（表格存储）---
TABLESTORE_ENDPOINT=https://你的实例.你的区域.ots.aliyuncs.com
TABLESTORE_INSTANCE=你的实例名
TABLESTORE_AK_ID=RAM子账号AccessKeyId
TABLESTORE_AK_SECRET=RAM子账号AccessKeySecret

# --- 邮箱发送（SMTP，用于发验证码；不配则打印到控制台供测试）---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=QQ邮箱授权码（不是密码！在QQ邮箱设置→账户→POP3/SMTP服务里获取）
SMTP_FROM=你的邮箱@qq.com

# --- 听力 TTS（可选；不配则该功能自动停用）---
# NLS_AK_ID=
# NLS_AK_SECRET=
# NLS_APPKEY_MALE=
# NLS_APPKEY_FEMALE=

# --- 业务参数（可选）---
FREE_CREDITS=100
